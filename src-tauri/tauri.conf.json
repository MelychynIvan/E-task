{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E-task",
  "version": "0.1.0",
  "identifier": "com.melychyn.etask",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "E-task",
        "width": 1320,
        "height": 860,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
